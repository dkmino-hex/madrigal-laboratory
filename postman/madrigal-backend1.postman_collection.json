    },
    {
      "key": "captureSnapshotId",
      "value": ""
    },
    {
      "key": "artifactId",
      "value": ""
    },
    {
      "key": "importId",
      "value": ""
    },
    {
      "key": "importedProjectId",
      "value": ""
