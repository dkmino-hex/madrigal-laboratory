{
  "name": "madrigal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "dev:api": "vite --mode api --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src e2e scripts \"*.ts\" \"*.json\"",
    "format": "prettier --write src e2e scripts \"*.ts\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:repository": "node --test scripts/repository-safety.test.mjs",
    "test:e2e:mock": "playwright test --config playwright.config.ts",
    "test:e2e:api": "node scripts/api-preflight.mjs && playwright test --config playwright.api.config.ts",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.ts",
    "test:e2e:browsers": "playwright test --config playwright.browsers.config.ts",
    "build": "npm run typecheck && vite build --mode api && node scripts/production-clean.mjs",
    "build:mock": "npm run typecheck && vite build --mode mock",
    "preview": "vite preview --host 127.0.0.1",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "verify": "npm run typecheck && npm run lint && npm run api:check && npm run test:repository && npm test && npm run build",
    "test:visual": "playwright test --grep \"Визуальный аудит\"",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts",
    "test:e2e:research": "playwright test --config playwright.research.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/view": "6.43.14",
    "@radix-ui/react-dialog": "1.2.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-virtual": "3.14.15",
    "@uiw/react-codemirror": "4.25.12",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
